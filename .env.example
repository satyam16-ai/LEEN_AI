# =============================================================================
# AI Personal Teacher System - Environment Variables
# Copy this file to .env and update values for your environment
# =============================================================================

# --------------- Application ---------------
APP_NAME=ai-personal-teacher
APP_ENV=development
APP_PORT=8000

# --------------- Frontend ---------------
# Relative: the API is same-origin through Nginx (Docker) or the Vite proxy (local)
VITE_API_URL=/api/v1

# --------------- Database (PostgreSQL) ---------------
POSTGRES_DB=leen_ai
POSTGRES_USER=leen
POSTGRES_PASSWORD=leen_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://leen:leen_dev_password@localhost:5432/leen_ai

# --------------- Redis ---------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --------------- Auth & Email (see backend/.env.example for all options) ---------------
SECRET_KEY=dev-insecure-secret-change-me-before-deploying
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:8081
SMTP_HOST=localhost
SMTP_PORT=1025

# --------------- AI whiteboard tutor ---------------
# Shared with the Claude Code bridge (python3 infrastructure/claude-bridge/claude_bridge.py)
CLAUDE_BRIDGE_TOKEN=dev-bridge-token
