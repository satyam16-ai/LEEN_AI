APP_NAME=ai-personal-teacher
APP_ENV=development
APP_PORT=8000

DATABASE_URL=postgresql://leen:leen_dev_password@localhost:5432/leen_ai

REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated; the SPA is normally same-origin via Nginx / the Vite proxy
CORS_ORIGINS=http://localhost:3000
# Used to build links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:3000

# --- Auth ---
# Generate for real deployments: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SESSION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# Must be true when served over HTTPS (required in production)
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
LINK_CODE_TTL_HOURS=48

# --- Media (avatars are stored here and served at /media) ---
MEDIA_ROOT=media
MAX_AVATAR_BYTES=2097152

# --- Email (Mailpit in dev: SMTP 1025, inbox at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=LEEN AI <no-reply@leen.ai>

# --- AI whiteboard tutor (Claude Code bridge: infrastructure/claude-bridge) ---
# Docker overrides the URL with http://host.docker.internal:8765
CLAUDE_BRIDGE_URL=http://localhost:8765
CLAUDE_BRIDGE_TOKEN=dev-bridge-token
WHITEBOARD_MODEL=sonnet
WHITEBOARD_EFFORT=low
# Neural narration voices (edge-tts, needs internet; audio cached in Redis)
TTS_ENABLED=true
